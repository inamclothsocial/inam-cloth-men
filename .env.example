# Shopify Storefront API Configuration (Template)
# Example: your-store.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com

# Example: 8f9a2b3c4d5e6f7a8b9c0d1e2f3a4b5c
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# API Version
VITE_SHOPIFY_API_VERSION=2024-10
